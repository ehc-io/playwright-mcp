# Playwright MCP Server - Environment Configuration
# Copy this file to .env and adjust as needed

# ================================
# Port Configuration
# ================================

# Headless service port (default: 3020)
MCP_HEADLESS_PORT=3020

# Headed service port (default: 3021)
MCP_HEADED_PORT=3021

# ================================
# Display Configuration (Headed Mode)
# ================================

# macOS (with XQuartz installed):
#   DISPLAY=host.docker.internal:0
#
# Linux:
#   DISPLAY=:0
#   Run: xhost +local:docker
#   Use: docker compose -f docker-compose.yml -f docker-compose.linux.yml --profile headed up -d
#
# WSL2/WSLg:
#   DISPLAY=:0
#   Use: docker compose -f docker-compose.yml -f docker-compose.wsl.yml --profile headed up -d

DISPLAY=host.docker.internal:0

# ================================
# MCP Client Connection URLs
# ================================
# Headless: http://localhost:3020/mcp
# Headed:   http://localhost:3021/mcp
#
# Legacy SSE endpoint also available:
# Headless: http://localhost:3020/sse
# Headed:   http://localhost:3021/sse
